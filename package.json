{
  "name": "community-events-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "db:admin": "tsx --env-file=.env prisma/seed-admin.ts",
    "test:phase2": "node --env-file=.env scripts/verify-phase2.mjs",
    "test:phase3": "tsx --env-file=.env scripts/verify-phase3.ts",
    "test:phase4": "node --env-file=.env scripts/verify-phase4.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "jose": "^6.2.12",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "6.12.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
