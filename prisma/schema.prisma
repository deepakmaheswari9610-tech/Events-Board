generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum CardTheme {
  SUNSET
  OCEAN
  GARDEN
}

model User {
  id           Int                 @id @default(autoincrement())
  email        String              @unique @db.VarChar(254)
  passwordHash String              @db.VarChar(255)
  role         Role                @default(USER)
  createdAt    DateTime            @default(now())
  favourites   FavouriteCategory[]
  reminders    Reminder[]
  designs      CardDesign[]
}

model Event {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(180)
  categoryId  Int
  category    Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cityId      Int
  city        City         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  startsAt    DateTime     @db.DateTime(3)
  price       Decimal      @db.Decimal(12, 2)
  description String       @db.Text
  imageUrl    String       @db.VarChar(2048)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  reminders   Reminder[]
  designs     CardDesign[]

  @@index([active, startsAt])
  @@index([active, categoryId, cityId, startsAt])
}

model Category {
  id         Int                 @id @default(autoincrement())
  name       String              @unique @db.VarChar(100)
  createdAt  DateTime            @default(now())
  events     Event[]
  favourites FavouriteCategory[]
}

model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  createdAt DateTime @default(now())
  events    Event[]
}

model FavouriteCategory {
  userId     Int
  categoryId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([userId, categoryId])
  @@index([categoryId])
}

model Reminder {
  userId    Int
  eventId   Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([userId, eventId])
  @@index([eventId])
}

model CardDesign {
  userId    Int
  eventId   Int
  theme     CardTheme @default(SUNSET)
  stickers  Json
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Restrict)

  @@id([userId, eventId])
  @@index([eventId])
}
