generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}
enum Category {
  Music
  Workshop
  Food
  Sports
  Kids
}
enum Role {
  USER
  ADMIN
}
enum CardTheme {
  SUNSET
  OCEAN
  GARDEN
}
model User {
  id String @id @default(cuid())
  email String @unique @db.VarChar(254)
  passwordHash String @db.VarChar(255)
  role Role @default(USER)
  createdAt DateTime @default(now())
  favourites FavouriteCategory[]
  reminders Reminder[]
  designs CardDesign[]
}
model Event {
  id String @id @default(cuid())
  title String @db.VarChar(180)
  category Category
  city String @db.VarChar(100)
  startsAt DateTime @db.DateTime(3)
  price Decimal @db.Decimal(12, 2)
  description String @db.Text
  imageUrl String @db.VarChar(2048)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  reminders Reminder[]
  designs CardDesign[]
  @@index([active, startsAt])
  @@index([active, category, city, startsAt])
}
model FavouriteCategory {
  userId String
  category Category
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, category])
}
model Reminder {
  userId String
  eventId String
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  @@id([userId, eventId])
  @@index([eventId])
}
model CardDesign {
  userId String
  eventId String
  theme CardTheme @default(SUNSET)
  stickers Json
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  @@id([userId, eventId])
  @@index([eventId])
}
